# Copy this file to .env and replace every value. .env is never committed.
# Use only letters, digits, - and _ : the database password goes inside a URL.

# encounter-db: the admin login (used only to create the database) and the
# Encounter Service's own login
ENCOUNTER_DB_ADMIN_PASSWORD=change-me
ENCOUNTER_DB_PASSWORD=change-me

# Shared by the Encounter Service and the Monster Service for the /internal calls
INTERNAL_SERVICE_SECRET=change-me
