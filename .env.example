# Copy this file to .env and replace every value. .env is never committed.
# Use only letters, digits, - and _ : database passwords are embedded in URLs.

# Encounter DB admin login and the Encounter Service's own login
ENCOUNTER_DB_ADMIN_PASSWORD=change-me
ENCOUNTER_DB_PASSWORD=change-me

# Monster DB admin login and the Monster Service's own login
MONSTER_DB_ADMIN_PASSWORD=change-me
MONSTER_DB_PASSWORD=change-me

# Shared by the Encounter Service and the Monster Service for /internal calls
INTERNAL_SERVICE_SECRET=change-me
