meta {
  name: Grant Reward NaN
  type: http
  seq: 2
}

post {
  url: {{monsterUrl}}/internal/rewards
  body: text
  auth: none
}

headers {
  Content-Type: application/json
  X-Internal-Secret: {{internalSecret}}
}

body:text {
  {
    "player_id": "player_01",
    "captured_species_id": NaN,
    "encounter_id": "enc_001"
  }
}

assert {
  res.status: eq 400
}