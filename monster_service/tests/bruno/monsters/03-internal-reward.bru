meta {
  name: Grant Reward
  type: http
  seq: 3
}

post {
  url: {{monsterUrl}}/internal/rewards
  body: json
  auth: none
}

headers {
  X-Internal-Secret: {{internalSecret}}
}

script:pre-request {
  const unique = Date.now() + "_" + Math.random().toString(36).slice(2, 8);
  bru.setVar("dynamicEncounterId", "enc_" + unique);
  bru.setVar("dynamicPlayerId", "player_" + unique);
}

body:json {
  {
    "player_id": "{{dynamicPlayerId}}",
    "captured_species_id": 11,
    "encounter_id": "{{dynamicEncounterId}}"
  }
}

assert {
  res.status: eq 201
  res.body.reward.monster.id: eq 11
}